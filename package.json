{
  "name": "gravitrdr",
  "description": "GravitRDR, the forked versatile Design Tool. Continued development by RDR, which is unrelated to the original Gravit project and Corel Vector.",
  "author": "NellowTCS",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "make-pretty": "prettier --write .",
    "build": "vite build",
    "desktop": "npm run build && electron shell/electron",
    "desktop:run": "VITE_DEV_SERVER_URL=http://localhost:8999 electron shell/electron",
    "dist": "npm run build && electron-builder --config shell/electron/electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --config shell/electron/electron-builder.yml --dir",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7",
    "modern-normalize": "3.0.1",
    "prettier": "^3.9.6",
    "sass": "1.102.0",
    "terser": "^5.49.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "colorthief": "^3.5.0",
    "jqtree": "1.9.0",
    "jquery": "4.0.0",
    "lodash": "^4.18.1",
    "mousetrap": "1.6.5",
    "opentype.js": "2.0.0",
    "pako": "3.0.1",
    "rangy": "1.3.2",
    "urijs": "1.19.11",
    "wawoff2": "^2.0.1"
  }
}
